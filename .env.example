# ─── Callback configuration ───────────────────────────────────────────────
# Copy this file to .env, or just enter your key in the dashboard on first run.

# Your Anthropic API key. Get one at https://console.anthropic.com/
# Callback only ever sends data to Anthropic's API, and only for the agent
# actions you explicitly trigger. Nothing is sent anywhere else — ever.
ANTHROPIC_API_KEY=

# ─── Optional overrides ───────────────────────────────────────────────────
# Port the local server listens on (dashboard dev server proxies to it).
# CALLBACK_PORT=4317

# Force the offline demo pipeline (no API key or network needed). Great for
# trying the UI, recording a demo, or developing without spending tokens.
# CALLBACK_DEMO=1

# Model routing (sensible defaults are built in — only set to override).
# CALLBACK_MODEL_ORCHESTRATOR=claude-opus-5-5
# CALLBACK_MODEL_WRITER=claude-sonnet-5-5
# CALLBACK_MODEL_EXTRACTOR=claude-haiku-5-5

# Hard spend ceiling per agent run, in USD. A run aborts if it exceeds this.
# CALLBACK_MAX_RUN_USD=1.00
