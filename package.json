{
  "name": "callback-agent",
  "version": "0.1.0",
  "description": "Callback — a local-first, open-source AI job-search & interview-prep agent. Your data never leaves your machine. Built on Claude.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "job-search",
    "interview-prep",
    "resume",
    "cover-letter",
    "ats",
    "claude",
    "claude-agent-sdk",
    "claude-code-plugin",
    "mcp",
    "local-first",
    "ai-agent"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "callback": "bin/callback.mjs"
  },
  "files": [
    "bin",
    "dist",
    "skills",
    ".claude-plugin",
    ".env.example"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:web": "vite",
    "build": "vite build && node scripts/build-server.mjs",
    "start": "node bin/callback.mjs",
    "tui": "node bin/callback.mjs tui",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run typecheck && npm run build"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.310",
    "@anthropic-ai/sdk": "^0.93.0",
    "@hono/node-server": "^2.1.5",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "docx": "^9.14.0",
    "hono": "^4.13.14",
    "ink": "^8.0.0",
    "ink-gradient": "^4.0.1",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "mammoth": "^1.13.0",
    "nanoid": "^6.0.2",
    "pdfkit": "^0.20.2",
    "react": "^19.3.1",
    "unpdf": "^1.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pdfkit": "^0.17.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "react-devtools-core": "^6.1.5",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
